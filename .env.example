# Copy this file to .env and fill in your values. Never commit .env.
# Restart `npx expo start` after changing it.

# Supabase dashboard → Project Settings → API Keys
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Google Maps (needed from Phase 2 onward)
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
